<resources>
    <style name="Midnight" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:alertDialogTheme">@style/MidnightDialog</item>
        <item name="android:windowBackground">#0e0f13</item>
        <item name="android:colorAccent">#8b7cff</item>
        <item name="android:colorBackground">#16181d</item>
        <item name="android:statusBarColor">#0e0f13</item>
        <item name="android:navigationBarColor">#0e0f13</item>
        <item name="android:fontFamily">sans</item>
